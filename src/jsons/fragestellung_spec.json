{
  "config": {
    "view": {
      "continuousWidth": 300,
      "continuousHeight": 300
    }
  },
  "data": {
    "url": "mydata"
  },
  "mark": {
    "type": "bar",
    "size": 140
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "datum.rank == 1",
        "value": "red"
      },
      "value": "lightgray"
    },
    "tooltip": [
      {
        "field": "sum_adults",
        "title": "Anzahl Erwachsene insgesamt",
        "type": "quantitative"
      },
      {
        "field": "sum_ltr",
        "title": "Anzahl Erwachsene nach ltr",
        "type": "quantitative"
      }
    ],
    "x": {
      "axis": {
        "title": "Untersuchte Strassen",
        "titleFontSize": 18,
        "labelAngle": 0,
        "labelFontSize": 16
      },
      "field": "location_name",
      "type": "nominal"
    },
    "y": {
      "axis": {
        "title": "Anteil der Erwachsenen die zum Bahnof gehen",
        "titleFontSize": 18,
        "format": ".0%",
        "labelFontSize": 16,
        "tickCount": 7
      },
      "field": "mean_percent",
      "type": "quantitative"
    }
  },
  "height": 500,
  "transform": [
    {
      "calculate": "datum.adult_ltr_pedestrians_count/datum.adult_pedestrians_count",
      "as": "PercentOfadult_ltr_pedestrians"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "PercentOfadult_ltr_pedestrians",
          "as": "mean_percent"
        },
        {
          "op": "sum",
          "field": "adult_pedestrians_count",
          "as": "sum_adults"
        },
        {
          "op": "sum",
          "field": "adult_ltr_pedestrians_count",
          "as": "sum_ltr"
        }
      ],
      "groupby": [
        "location_name"
      ]
    },
    {
      "window": [
        {
          "op": "rank",
          "field": "mean_percent",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "mean_percent",
          "order": "descending"
        }
      ]
    }
  ],
  "width": 800,
  "$schema": "https://vega.github.io/schema/vega-lite/v5.20.1.json"
}