{
  "config": {
    "view": {
      "continuousWidth": 300,
      "continuousHeight": 300
    }
  },
  "data": {
    "url": "mydata"
  },
  "mark": {
    "type": "bar",
    "size": 140
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "datum.rank == 1",
        "value": "red"
      },
      "value": "lightgray"
    },
    "tooltip": [
      {
        "field": "sum_daten",
        "title": "Anzahl Personen:",
        "type": "quantitative"
      }
    ],
    "x": {
      "axis": {
        "title": "Untersuchte Strassen",
        "titleFontSize": 18,
        "labelAngle": 0,
        "labelFontSize": 16
      },
      "field": "location_name",
      "type": "nominal"
    },
    "y": {
      "axis": {
        "title": "Anzahl Personen",
        "titleFontSize": 18,
        "labelFontSize": 16,
        "tickCount": 7
      },
      "field": "sum_daten",
      "type": "quantitative"
    }
  },
  "height": 500,
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Daten",
          "as": "sum_daten"
        }
      ],
      "groupby": [
        "location_name"
      ]
    },
    {
      "window": [
        {
          "op": "rank",
          "field": "sum_daten",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "sum_daten",
          "order": "descending"
        }
      ]
    }
  ],
  "width": 800,
  "$schema": "https://vega.github.io/schema/vega-lite/v5.20.1.json"
}