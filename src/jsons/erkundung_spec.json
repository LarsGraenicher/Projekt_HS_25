{
  "config": {
    "view": {
      "continuousWidth": 300,
      "continuousHeight": 300
    }
  },
  "data": {
    "url": "mydata"
  },
  "mark": {
    "type": "bar",
    "size": 100
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "datum.rank == 1",
        "value": "red"
      },
      "value": "lightgray"
    },
    "tooltip": [
      {
        "field": "sum_daten",
        "title": "Anzahl Personen:",
        "type": "quantitative"
      }
    ],
    "x": {
      "axis": {
        "title": "Untersuchte Strassen",
        "labelAngle": 0
      },
      "field": "location_name",
      "type": "nominal"
    },
    "y": {
      "axis": {
        "title": "Anzahl Personen"
      },
      "field": "sum_daten",
      "type": "quantitative"
    }
  },
  "params": [
    {
      "name": "param_11",
      "select": {
        "type": "interval",
        "encodings": [
          "x",
          "y"
        ]
      },
      "bind": "scales"
    }
  ],
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Daten",
          "as": "sum_daten"
        }
      ],
      "groupby": [
        "location_name"
      ]
    },
    {
      "window": [
        {
          "op": "rank",
          "field": "sum_daten",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "sum_daten",
          "order": "descending"
        }
      ]
    }
  ],
  "width": 600,
  "$schema": "https://vega.github.io/schema/vega-lite/v5.20.1.json"
}